rules_version = '2';

// P03/P04 protect roles, profiles, enrollment and resource permissions.
// Round/finalization correctness remains a separate gate.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // Trusted registry: only Admin provisioning can create/delete profiles.
    function isLecturer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid));
    }

    function isOwner(lecturerId) {
      return isLecturer() && request.auth.uid == lecturerId;
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('lifecycle_status', 'active') == 'active'
        && !isLecturer();
    }

    function ownsModule(id) {
      return isOwner(get(/databases/$(database)/documents/modules/$(id)).data.lecturer_id);
    }

    function ownsSession(id) {
      let session = get(/databases/$(database)/documents/active_sessions/$(id)).data;
      return isOwner(session.lecturer_id) && ownsModule(session.module_id);
    }

    function activeSession(id) {
      return get(/databases/$(database)/documents/active_sessions/$(id)).data.status == 'active';
    }

    function ownRecord(data) {
      return isStudent() && (data.get('student_uid', '') == request.auth.uid
        || data.get('student_id', '') == request.auth.uid);
    }

    function validStudentInSession(data, sessionId) {
      let session = get(/databases/$(database)/documents/active_sessions/$(sessionId)).data;
      let uid = data.get('student_uid', data.get('student_id', ''));
      let student = get(/databases/$(database)/documents/students/$(uid)).data;
      return uid is string && uid != ''
        && data.get('student_id', uid) == uid
        && student.get('lifecycle_status', 'active') == 'active'
        && (session.get('round_schema', 1) == 2
          ? get(/databases/$(database)/documents/active_sessions/$(sessionId)/roster/$(uid)).data.reg_no == student.reg_no
          : session.module_id in student.get('enrolled_module_ids', []))
        && data.get('module_id', session.module_id) == session.module_id
        && data.get('module_code', session.module_id) == session.module_id
        && data.get('reg_no', student.reg_no) == student.reg_no;
    }

    function validProvisionalSummary(data, sessionId) {
      let session = get(/databases/$(database)/documents/active_sessions/$(sessionId)).data;
      return session.get('round_schema', 1) != 2
          || (data.status == 'pending'
            && !data.keys().hasAny(['finalization_version', 'final_status', 'credited', 'excused', 'marked_late', 'manual', 'corrected_at', 'marked_by']));
    }

    function validCounterUpdate() {
      let next = request.resource.data.attendance_counts;
      let previous = resource.data.get('attendance_counts', {});
      let keys = next.diff(previous).affectedKeys();
      let id = request.resource.data.get('attendance_module_id', '');
      return next is map && ((keys.size() == 0 && !changedFields().hasAny(['attendance_module_id']))
        || (id is string && id != '' && ownsModule(id)
          && (id in resource.data.get('enrolled_module_ids', [])
            || eligibleCounterSession(id))
          && request.resource.data.get('attendance_session_id', '') != ''
          && ownsSession(request.resource.data.attendance_session_id)
          && get(/databases/$(database)/documents/active_sessions/$(request.resource.data.attendance_session_id)).data.module_id == id
          && activeSession(request.resource.data.attendance_session_id)
          && keys.hasOnly([id]) && next[id] is int && next[id] >= 0));
    }

    function eligibleCounterSession(moduleId) {
      let id = request.resource.data.get('attendance_session_id', '');
      let session = get(/databases/$(database)/documents/active_sessions/$(id)).data;
      return id != '' && ownsSession(id) && session.module_id == moduleId
        && get(/databases/$(database)/documents/active_sessions/$(id)/roster/$(resource.data.uid)).data.reg_no == resource.data.reg_no;
    }

    function validRoundTransition() {
      let old = resource.data.get('active_round_id', null);
      let next = request.resource.data.get('active_round_id', null);
      let beforeCount = resource.data.get('scans_performed', 0);
      let afterCount = request.resource.data.get('scans_performed', 0);
      return !changedFields().hasAny(['active_round_id', 'rounds_started', 'scans_performed'])
        || (resource.data.status == 'active' && request.resource.data.status == 'active'
          && ((old == null && next is string
            && request.resource.data.rounds_started == resource.data.rounds_started + 1
            && afterCount == beforeCount
            && getAfter(/databases/$(database)/documents/active_sessions/$(resource.data.session_id)/rounds/$(next)).data.status == 'open'
            && getAfter(/databases/$(database)/documents/active_sessions/$(resource.data.session_id)/rounds/$(next)).data.ordinal == request.resource.data.rounds_started)
          || (old is string && next == null
            && request.resource.data.rounds_started == resource.data.rounds_started
            && ((afterCount == beforeCount + 1
              && getAfter(/databases/$(database)/documents/active_sessions/$(resource.data.session_id)/rounds/$(old)).data.status == 'completed')
            || (afterCount == beforeCount
              && getAfter(/databases/$(database)/documents/active_sessions/$(resource.data.session_id)/rounds/$(old)).data.status == 'cancelled')))));
    }

    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validLoginTime() {
      return !changedFields().hasAny(['last_login'])
        || request.resource.data.last_login == request.time;
    }

    // First binding supports absent/null/empty legacy states. Later clients
    // cannot reset/replace it or forge its server timestamp.
    function validBinding() {
      let changed = changedFields();
      let oldId = resource.data.get('device_id', null);
      return !changed.hasAny(['device_id', 'device_locked_at', 'device_model'])
        || ((oldId == null || oldId == '')
          && changed.hasAll(['device_id', 'device_locked_at'])
          && request.resource.data.device_id is string
          && request.resource.data.device_id.size() <= 256
          && request.resource.data.device_id.matches('.*\\S.*')
          && request.resource.data.device_locked_at == request.time
          && (!changed.hasAny(['device_model'])
            || (request.resource.data.device_model is string
              && request.resource.data.device_model.size() <= 256)));
    }

    function validLecturerPresentation() {
      let changed = changedFields();
      return (!changed.hasAny(['name']) || request.resource.data.name is string)
        && (!changed.hasAny(['fullName']) || request.resource.data.fullName is string)
        && (!changed.hasAny(['department']) || request.resource.data.department is string);
    }

    match /lecturers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid == uid
        && changedFields().hasOnly(['name', 'fullName', 'department',
          'device_id', 'device_model', 'device_locked_at', 'last_login'])
        && validLecturerPresentation() && validBinding() && validLoginTime();
    }

    match /students/{uid} {
      // Global CRUD uses the trusted API. Counter writes require module owner
      // context and enrollment; round/idempotency semantics remain for P05/06.
      allow read: if (isStudent() && request.auth.uid == uid) || isLecturer();
      allow create, delete: if false;
      allow update: if (isStudent() && request.auth.uid == uid
          && changedFields().hasOnly(['device_id', 'device_locked_at', 'last_login'])
          && validBinding() && validLoginTime())
        || (isLecturer() && changedFields().hasOnly(['attendance_counts', 'attendance_module_id', 'attendance_session_id'])
          && validCounterUpdate());

      match /enrollments/{moduleId} {
        allow read: if exists(/databases/$(database)/documents/students/$(uid))
          && ((isStudent() && request.auth.uid == uid) || ownsModule(moduleId));
        allow write: if false;
      }
    }

    match /module_secrets/{id} { allow read, write: if false; }

    match /module_catalog/{id} {
      allow read: if isStudent() || isLecturer();
      allow create, delete: if false;
      // Only mirrored aggregate fields are writable by the owning mobile
      // lecturer; all metadata/secret changes use trusted management routes.
      allow update: if false; // Aggregates commit only through trusted API.
    }

    match /modules/{moduleCode} {
      allow read: if isOwner(resource.data.lecturer_id);
      allow create, delete: if false;
      allow update: if false;
    }

    match /active_sessions/{sessionId} {
      allow read: if isOwner(resource.data.lecturer_id) && ownsModule(resource.data.module_id);
      allow create: if isOwner(request.resource.data.lecturer_id)
        && ownsModule(request.resource.data.module_id)
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['finalization_version', 'completed_at'])
        && (request.resource.data.get('round_schema', 1) != 2
          || (request.resource.data.scans_performed == 0
            && request.resource.data.rounds_started == 0
            && request.resource.data.active_round_id == null))
        && request.resource.data.get('module_code', request.resource.data.module_id) == request.resource.data.module_id;
      allow update: if ownsSession(sessionId)
        && activeSession(sessionId)
        && (resource.data.get('round_schema', 1) != 2 || request.resource.data.status == 'active')
        && !changedFields().hasAny(['lecturer_id', 'module_id', 'module_code', 'module', 'session_id', 'eligible_roster', 'round_schema'])
        && (resource.data.get('round_schema', 1) != 2 || validRoundTransition());
      allow delete: if false;

      match /corrections/{correctionId} {
        allow read: if ownsSession(sessionId);
        allow write: if false;
      }

      match /roster/{studentId} {
        allow read: if ownsSession(sessionId) || (isStudent() && request.auth.uid == studentId);
        allow create: if !exists(/databases/$(database)/documents/active_sessions/$(sessionId))
          && isOwner(getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.lecturer_id)
          && ownsModule(request.resource.data.module_id)
          && request.resource.data.keys().hasOnly(['student_uid', 'reg_no', 'module_id', 'captured_at'])
          && request.resource.data.student_uid == studentId
          && !exists(/databases/$(database)/documents/lecturers/$(studentId))
          && request.resource.data.captured_at == request.time
          && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.round_schema == 2
          && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.module_id == request.resource.data.module_id
          && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.eligible_roster.get(studentId, '') == request.resource.data.reg_no
          && get(/databases/$(database)/documents/students/$(studentId)).data.reg_no == request.resource.data.reg_no
          && get(/databases/$(database)/documents/students/$(studentId)).data.get('lifecycle_status', 'active') == 'active'
          && request.resource.data.module_id in get(/databases/$(database)/documents/students/$(studentId)).data.enrolled_module_ids;
        allow update, delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if ownsSession(sessionId);
        allow create: if ownsSession(sessionId)
          && request.resource.data.keys().hasOnly(['round_id', 'ordinal', 'status', 'started_at'])
          && request.resource.data.round_id == roundId
          && request.resource.data.status == 'open'
          && request.resource.data.started_at == request.time
          && get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.status == 'active'
          && get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.active_round_id == null
          && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.active_round_id == roundId
          && request.resource.data.ordinal == getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.rounds_started;
        allow update: if ownsSession(sessionId) && resource.data.status == 'open'
          && request.resource.data.status in ['completed', 'cancelled']
          && changedFields().hasOnly(['status', 'finished_at'])
          && request.resource.data.finished_at == request.time
          && get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.status == 'active'
          && get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.active_round_id == roundId
          && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.active_round_id == null;
        allow delete: if false;

        match /observations/{studentId} {
          allow read: if ownsSession(sessionId) || ownRecord(resource.data);
          allow create: if ownsSession(sessionId)
            && request.resource.data.keys().hasOnly(['session_id', 'round_id', 'student_uid', 'student_id', 'reg_no', 'module_id', 'module_code', 'rssi', 'observed_at'])
            && request.resource.data.session_id == sessionId
            && request.resource.data.round_id == roundId
            && request.resource.data.student_uid == studentId
            && request.resource.data.rssi is int
            && request.resource.data.observed_at == request.time
            && validStudentInSession(request.resource.data, sessionId)
            && get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)).data.active_round_id == roundId
            && getAfter(/databases/$(database)/documents/active_sessions/$(sessionId)/rounds/$(roundId)).data.status == 'open';
          allow update, delete: if false;
        }
      }

      match /attendance/{regNo} {
        allow read: if ownsSession(sessionId) || ownRecord(resource.data);
        allow create: if ownsSession(sessionId) && validStudentInSession(request.resource.data, sessionId)
          && activeSession(sessionId)
          && validProvisionalSummary(request.resource.data, sessionId)
          && (request.resource.data.get('round_schema', 1) == 2
            ? request.resource.data.student_uid == regNo
            : request.resource.data.reg_no == regNo);
        allow update: if ownsSession(sessionId) && validStudentInSession(request.resource.data, sessionId)
          && activeSession(sessionId)
          && validProvisionalSummary(request.resource.data, sessionId)
          && !changedFields().hasAny(['finalization_version', 'final_status', 'credited', 'excused', 'marked_late', 'manual', 'corrected_at', 'marked_by'])
          && !changedFields().hasAny(['student_uid', 'student_id', 'reg_no', 'session_id', 'module_id', 'module_code']);
        allow delete: if false;
      }
    }

    match /attendance_records/{recordId} {
      allow read: if (resource == null && ownsSession(recordId.split('[.]')[0]))
        || ownRecord(resource.data) || ownsSession(resource.data.session_id);
      allow create: if ownsSession(request.resource.data.session_id)
        && activeSession(request.resource.data.session_id)
        && validProvisionalSummary(request.resource.data, request.resource.data.session_id)
        && validStudentInSession(request.resource.data, request.resource.data.session_id);
      allow update: if ownsSession(resource.data.session_id)
        && activeSession(resource.data.session_id)
        && validProvisionalSummary(request.resource.data, resource.data.session_id)
        && !changedFields().hasAny(['finalization_version', 'final_status', 'credited', 'excused', 'marked_late', 'manual', 'corrected_at', 'marked_by'])
        && !changedFields().hasAny(['student_uid', 'student_id', 'reg_no', 'session_id', 'module_id', 'module_code']);
      allow delete: if false;
    }

    match /absence_records/{recordId} {
      allow read: if ownRecord(resource.data) || ownsSession(resource.data.session_id);
      allow create: if ownsSession(request.resource.data.session_id)
        && activeSession(request.resource.data.session_id)
        && validStudentInSession(request.resource.data, request.resource.data.session_id);
      allow update: if ownsSession(resource.data.session_id)
        && activeSession(resource.data.session_id)
        && !changedFields().hasAny(['student_uid', 'student_id', 'session_id', 'module_id', 'module_code']);
      allow delete: if ownsSession(resource.data.session_id) && activeSession(resource.data.session_id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
