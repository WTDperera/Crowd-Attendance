rules_version = '2';

// P03/P04 protect roles, profiles, enrollment and resource permissions.
// Round/finalization correctness remains a separate gate.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // Trusted registry: only Admin provisioning can create/delete profiles.
    function isLecturer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/lecturers/$(request.auth.uid));
    }

    function isOwner(lecturerId) {
      return isLecturer() && request.auth.uid == lecturerId;
    }

    function isStudent() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('lifecycle_status', 'active') == 'active'
        && !isLecturer();
    }

    function ownsModule(id) {
      return isOwner(get(/databases/$(database)/documents/modules/$(id)).data.lecturer_id);
    }

    function ownsSession(id) {
      let session = get(/databases/$(database)/documents/active_sessions/$(id)).data;
      return isOwner(session.lecturer_id) && ownsModule(session.module_id);
    }

    function ownRecord(data) {
      return isStudent() && (data.get('student_uid', '') == request.auth.uid
        || data.get('student_id', '') == request.auth.uid);
    }

    function validStudentInSession(data, sessionId) {
      let session = get(/databases/$(database)/documents/active_sessions/$(sessionId)).data;
      let uid = data.get('student_uid', data.get('student_id', ''));
      let student = get(/databases/$(database)/documents/students/$(uid)).data;
      return uid is string && uid != ''
        && data.get('student_id', uid) == uid
        && student.get('lifecycle_status', 'active') == 'active'
        && session.module_id in student.get('enrolled_module_ids', [])
        && data.get('module_id', session.module_id) == session.module_id
        && data.get('module_code', session.module_id) == session.module_id
        && data.get('reg_no', student.reg_no) == student.reg_no;
    }

    function validCounterUpdate() {
      let next = request.resource.data.attendance_counts;
      let previous = resource.data.get('attendance_counts', {});
      let keys = next.diff(previous).affectedKeys();
      let id = request.resource.data.get('attendance_module_id', '');
      return next is map && ((keys.size() == 0 && !changedFields().hasAny(['attendance_module_id']))
        || (id is string && id != '' && ownsModule(id)
          && id in resource.data.get('enrolled_module_ids', [])
          && keys.hasOnly([id]) && next[id] is int && next[id] >= 0));
    }

    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validLoginTime() {
      return !changedFields().hasAny(['last_login'])
        || request.resource.data.last_login == request.time;
    }

    // First binding supports absent/null/empty legacy states. Later clients
    // cannot reset/replace it or forge its server timestamp.
    function validBinding() {
      let changed = changedFields();
      let oldId = resource.data.get('device_id', null);
      return !changed.hasAny(['device_id', 'device_locked_at', 'device_model'])
        || ((oldId == null || oldId == '')
          && changed.hasAll(['device_id', 'device_locked_at'])
          && request.resource.data.device_id is string
          && request.resource.data.device_id.size() <= 256
          && request.resource.data.device_id.matches('.*\\S.*')
          && request.resource.data.device_locked_at == request.time
          && (!changed.hasAny(['device_model'])
            || (request.resource.data.device_model is string
              && request.resource.data.device_model.size() <= 256)));
    }

    function validLecturerPresentation() {
      let changed = changedFields();
      return (!changed.hasAny(['name']) || request.resource.data.name is string)
        && (!changed.hasAny(['fullName']) || request.resource.data.fullName is string)
        && (!changed.hasAny(['department']) || request.resource.data.department is string);
    }

    match /lecturers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid == uid
        && changedFields().hasOnly(['name', 'fullName', 'department',
          'device_id', 'device_model', 'device_locked_at', 'last_login'])
        && validLecturerPresentation() && validBinding() && validLoginTime();
    }

    match /students/{uid} {
      // Global CRUD uses the trusted API. Counter writes require module owner
      // context and enrollment; round/idempotency semantics remain for P05/06.
      allow read: if (isStudent() && request.auth.uid == uid) || isLecturer();
      allow create, delete: if false;
      allow update: if (isStudent() && request.auth.uid == uid
          && changedFields().hasOnly(['device_id', 'device_locked_at', 'last_login'])
          && validBinding() && validLoginTime())
        || (isLecturer() && changedFields().hasOnly(['attendance_counts', 'attendance_module_id'])
          && validCounterUpdate());

      match /enrollments/{moduleId} {
        allow read: if exists(/databases/$(database)/documents/students/$(uid))
          && ((isStudent() && request.auth.uid == uid) || ownsModule(moduleId));
        allow write: if false;
      }
    }

    match /module_secrets/{id} { allow read, write: if false; }

    match /module_catalog/{id} {
      allow read: if isStudent() || isLecturer();
      allow create, delete: if false;
      // Only mirrored aggregate fields are writable by the owning mobile
      // lecturer; all metadata/secret changes use trusted management routes.
      allow update: if ownsModule(id)
        && changedFields().hasOnly(['total_sessions', 'session_dates'])
        && request.resource.data.total_sessions == getAfter(/databases/$(database)/documents/modules/$(id)).data.total_sessions
        && request.resource.data.session_dates == getAfter(/databases/$(database)/documents/modules/$(id)).data.session_dates;
    }

    match /modules/{moduleCode} {
      allow read: if isOwner(resource.data.lecturer_id);
      allow create, delete: if false;
      allow update: if isOwner(resource.data.lecturer_id)
        && changedFields().hasOnly(['total_sessions', 'session_dates'])
        && request.resource.data.total_sessions == getAfter(/databases/$(database)/documents/module_catalog/$(moduleCode)).data.total_sessions
        && request.resource.data.session_dates == getAfter(/databases/$(database)/documents/module_catalog/$(moduleCode)).data.session_dates;
    }

    match /active_sessions/{sessionId} {
      allow read: if isOwner(resource.data.lecturer_id) && ownsModule(resource.data.module_id);
      allow create: if isOwner(request.resource.data.lecturer_id)
        && ownsModule(request.resource.data.module_id)
        && request.resource.data.get('module_code', request.resource.data.module_id) == request.resource.data.module_id;
      allow update: if ownsSession(sessionId)
        && !changedFields().hasAny(['lecturer_id', 'module_id', 'module_code', 'module', 'session_id']);
      allow delete: if false;

      match /attendance/{regNo} {
        allow read: if ownsSession(sessionId) || ownRecord(resource.data);
        allow create: if ownsSession(sessionId) && validStudentInSession(request.resource.data, sessionId)
          && request.resource.data.reg_no == regNo;
        allow update: if ownsSession(sessionId) && validStudentInSession(request.resource.data, sessionId)
          && !changedFields().hasAny(['student_uid', 'student_id', 'reg_no', 'session_id', 'module_id', 'module_code']);
        allow delete: if false;
      }
    }

    match /attendance_records/{recordId} {
      allow read: if ownRecord(resource.data) || ownsSession(resource.data.session_id);
      allow create: if ownsSession(request.resource.data.session_id)
        && validStudentInSession(request.resource.data, request.resource.data.session_id);
      allow update: if ownsSession(resource.data.session_id)
        && !changedFields().hasAny(['student_uid', 'student_id', 'reg_no', 'session_id', 'module_id', 'module_code']);
      allow delete: if false;
    }

    match /absence_records/{recordId} {
      allow read: if ownRecord(resource.data) || ownsSession(resource.data.session_id);
      allow create: if ownsSession(request.resource.data.session_id)
        && validStudentInSession(request.resource.data, request.resource.data.session_id);
      allow update: if ownsSession(resource.data.session_id)
        && !changedFields().hasAny(['student_uid', 'student_id', 'session_id', 'module_id', 'module_code']);
      allow delete: if ownsSession(resource.data.session_id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
